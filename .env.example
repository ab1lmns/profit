# Node.js 22+; скопируйте файл в .env и задайте свой пароль.
TEACHER_PASSWORD=replace-with-your-password
API_PORT=3001
# Несколько преподавателей с доступом только к своим направлениям:
# TEACHERS_JSON='[{"login":"python-teacher","name":"Преподаватель Python","password":"replace-me","tracks":["python"]}]'
# Для HTTPS за обратным прокси:
# SECURE_COOKIES=true
# Для трансляции через разные сети укажите свой STUN/TURN:
# ICE_SERVERS_JSON='[{"urls":"stun:stun.example.org:3478"},{"urls":"turn:turn.example.org:3478","username":"exam","credential":"replace-me"}]'
# DATA_DIR=/absolute/path/to/persistent/data
